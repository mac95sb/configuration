#!/bin/sh

set -eu

if ! command -v herdr >/dev/null 2>&1; then
  printf '%s\n' 'herdr-dev: herdr is not installed. Run mise install first.' >&2
  exit 1
fi

if ! command -v nvim >/dev/null 2>&1; then
  printf '%s\n' 'herdr-dev: neovim is not installed. Run mise bootstrap packages apply first.' >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  printf '%s\n' 'herdr-dev: jq is not installed. Run mise bootstrap packages apply first.' >&2
  exit 1
fi

if ! command -v pi >/dev/null 2>&1; then
  printf '%s\n' 'herdr-dev: pi is not installed. Run mise install first.' >&2
  exit 1
fi

cwd=$(pwd -P)
label=$(basename "$cwd")

if ! herdr status server >/dev/null 2>&1; then
  herdr server >/dev/null 2>&1 &
  server_pid=$!
  trap 'kill "$server_pid" 2>/dev/null || true' EXIT HUP INT TERM

  attempts=0
  until herdr status server >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 20 ]; then
      printf '%s\n' 'herdr-dev: Herdr server did not start.' >&2
      exit 1
    fi
    sleep 0.25
  done
fi

workspace_json=$(herdr workspace create --cwd "$cwd" --label "$label" --focus)
workspace_id=$(printf '%s' "$workspace_json" | jq -er '.result.workspace.workspace_id')
editor_pane_id=$(printf '%s' "$workspace_json" | jq -er '.result.root_pane.pane_id')
agent_json=$(herdr pane split "$editor_pane_id" --direction right --ratio 0.4 --cwd "$cwd")
agent_pane_id=$(printf '%s' "$agent_json" | jq -er '.result.pane.pane_id')
terminal_json=$(herdr pane split "$agent_pane_id" --direction down --ratio 0.5 --cwd "$cwd")
terminal_pane_id=$(printf '%s' "$terminal_json" | jq -er '.result.pane.pane_id')

herdr pane run "$editor_pane_id" 'nvim "+WorkspaceLayout"' >/dev/null
herdr pane run "$agent_pane_id" 'pi' >/dev/null
herdr pane rename "$editor_pane_id" 'NeoVim' >/dev/null
herdr pane rename "$agent_pane_id" 'AI Agent (pi)' >/dev/null
herdr pane rename "$terminal_pane_id" 'Terminal' >/dev/null
herdr workspace focus "$workspace_id" >/dev/null

exec herdr
