#!/bin/sh
#MISE description="Stop legacy supervisors gracefully and activate the deployed root boot job"
#MISE interactive=true
#MISE extends="uncached"
set -eu
[ "$#" = 0 ] || exit 2
exec sudo /usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=/var/root \
  /bin/sh -eu -c '
  p=/usr/local/libexec/mac-server/tasks/daemon/activate-runtime
  for f in /usr /usr/local /usr/local/libexec /usr/local/libexec/mac-server /usr/local/libexec/mac-server/tasks /usr/local/libexec/mac-server/tasks/daemon "$p"; do
    [ ! -L "$f" ] && [ "$(stat -f %u "$f")" = 0 ] || exit 1
    m=$(stat -f %Lp "$f")
    [ "$((0$m & 022))" = 0 ] || exit 1
    a=$(ls -lde "$f")
    case ${a%% *} in *+*) exit 1 ;; esac
  done
  exec /bin/sh "$p"
'
