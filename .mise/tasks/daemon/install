#!/bin/sh
#MISE description="Point pitchfork's global config at this repo, expose binaries service accounts need, and register boot start"
#MISE depends=["daemon:relink"]
set -eu

sudo install -d -m 755 -o root -g wheel /etc/pitchfork
if [ ! /Users/mac/Developer/configuration/pitchfork.toml -ef /etc/pitchfork/config.toml ]; then
  sudo install -o root -g wheel -m 644 \
    /Users/mac/Developer/configuration/pitchfork.toml /etc/pitchfork/config.toml
fi
sudo chmod o+x /Users/mac
sudo install -d -m 750 -o svc_caddy -g observability /var/log/caddy
sudo install -d -m 750 -o mac -g observability /var/log/services
sudo install -o root -g wheel -m 644 \
  /Users/mac/Developer/configuration/services/logs/newsyslog.conf \
  /etc/newsyslog.d/services.conf
sudo pitchfork boot enable

# Keep boot start on the stable binary and restart the supervisor after failure.
plist=/Library/LaunchDaemons/pitchfork.plist
sudo /usr/libexec/PlistBuddy -c 'Set :ProgramArguments:0 /usr/local/bin/pitchfork' "$plist"
sudo /usr/libexec/PlistBuddy -c 'Add :KeepAlive bool true' "$plist" 2>/dev/null ||
  sudo /usr/libexec/PlistBuddy -c 'Set :KeepAlive true' "$plist"
