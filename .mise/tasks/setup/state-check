#!/bin/sh
#MISE description="Check existing recovery state, or prove a fresh setup has no service state"
#MISE interactive=true
#MISE extends="uncached"
#USAGE flag "--new" help="Require absence of all service state; otherwise require recovered/existing credentials and databases"
set -eu
if [ "${usage_new:-false}" = true ]; then
  # A matching operational identity is reusable; deployment later verifies that
  # its public recipient is present before installing the new reviewed config.
  for path in /etc/fnox/config.toml /etc/fnox/restic-password.age \
    /Library/LaunchDaemons/pitchfork.plist /Users/svc_forgejo/forgejo-data /Users/svc_observability/grafana-data; do
    if sudo test -e "$path" || sudo test -L "$path"; then
      printf 'Fresh setup refuses existing state: %s. Recover or inspect it; do not delete it merely to retry.\n' "$path" >&2
      exit 1
    fi
  done
  if [ -e "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Backups/configuration/restic-sh-v1/repository/config" ] ||
    [ -L "$HOME/Library/Mobile Documents/com~apple~CloudDocs/Backups/configuration/restic-sh-v1/repository/config" ]; then
    echo 'A Restic repository already exists in iCloud. Restore it; do not initialize this host as new.' >&2
    exit 1
  fi
else
  for path in /etc/fnox/config.toml /etc/fnox/operational.key /etc/fnox/restic-password.age \
    /Users/svc_forgejo/forgejo-data/data/forgejo.db /Users/svc_observability/grafana-data/grafana.db; do
    sudo test -f "$path" || {
      printf 'Existing setup requires %s. Follow README recovery; --new is only for empty services.\n' "$path" >&2
      exit 1
    }
  done
fi
for name in configuration robin; do
  [ -d "$HOME/Developer/$name/.git" ] || {
    printf 'Missing checkout: %s\n' "$HOME/Developer/$name" >&2
    exit 1
  }
done
