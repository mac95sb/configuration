#!/bin/sh
#MISE description="Test postinstall and fresh/existing setup guards without sudo or service changes"
#MISE extends="uncached"
set -eu
[ "$#" = 0 ] || exit 2
repo=${MISE_CONFIG_ROOT:?}
work=$(mktemp -d "${TMPDIR:-/tmp}/setup-fixture.XXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'exit 1' HUP INT TERM
mkdir "$work/bin"
cat >"$work/bin/sudo" <<'SUDO'
#!/bin/sh
case $1 in
  test)
    shift
    case "$1:${2:-}" in
      -L:/etc/fnox/config.toml) [ "${FIXTURE_CONFIG_LINK:-false}" = true ] ;;
      -e:/etc/fnox/config.toml) [ "${FIXTURE_CONFIG:-false}" = true ] ;;
      *) [ "${FIXTURE_READY:-false}" = true ] ;;
    esac
    ;;
  cmp) [ "${FIXTURE_CONFIG_MATCH:-false}" = true ] ;;
  *) exit 97 ;;
esac
SUDO
cat >"$work/bin/mise" <<'MISE'
#!/bin/sh
printf '%s\n' "$*" >>"$FIXTURE_LOG"
MISE
chmod 700 "$work/bin/sudo" "$work/bin/mise"
export PATH="$work/bin:$PATH" FIXTURE_LOG="$work/calls"
export MISE_INSTALLED_TOOLS=restic FIXTURE_READY=true
MISE_SETUP_IN_PROGRESS=1 /bin/sh "$repo/.mise/tasks/setup/auto"
[ ! -e "$FIXTURE_LOG" ]
FIXTURE_READY=false /bin/sh "$repo/.mise/tasks/setup/auto"
[ ! -e "$FIXTURE_LOG" ]
/bin/sh "$repo/.mise/tasks/setup/auto"
printf 'run daemon:install\nrun daemon:activate\n' >"$work/expected"
cmp "$work/expected" "$FIXTURE_LOG"
# State checks use disposable checkouts and a privilege shim.
mkdir -p "$work/home/Developer/configuration/.git" "$work/home/Developer/robin/.git"
HOME=$work/home FIXTURE_READY=true usage_new=false /bin/sh "$repo/.mise/tasks/setup/state-check"
if HOME=$work/home FIXTURE_READY=true usage_new=true /bin/sh "$repo/.mise/tasks/setup/state-check"; then
  echo 'Fresh setup accepted existing service state.' >&2
  exit 1
fi
HOME=$work/home FIXTURE_READY=false usage_new=true /bin/sh "$repo/.mise/tasks/setup/state-check"
HOME=$work/home FIXTURE_READY=false FIXTURE_CONFIG=true FIXTURE_CONFIG_MATCH=true usage_new=true \
  /bin/sh "$repo/.mise/tasks/setup/state-check"
if HOME=$work/home FIXTURE_READY=false FIXTURE_CONFIG=true FIXTURE_CONFIG_MATCH=false usage_new=true \
  /bin/sh "$repo/.mise/tasks/setup/state-check"; then
  echo 'Fresh setup accepted a different existing fnox config.' >&2
  exit 1
fi
if HOME=$work/home FIXTURE_READY=false FIXTURE_CONFIG_LINK=true usage_new=true \
  /bin/sh "$repo/.mise/tasks/setup/state-check"; then
  echo 'Fresh setup accepted a linked fnox config.' >&2
  exit 1
fi
if HOME=$work/home FIXTURE_READY=false usage_new=false /bin/sh "$repo/.mise/tasks/setup/state-check"; then
  echo 'Existing setup accepted missing recovery data.' >&2
  exit 1
fi
printf '%s\n' 'Postinstall preserves user/root separation; fresh setup can resume only with its exact reviewed config.'
