#!/bin/sh
#MISE description="Postinstall: maintain an existing server; never initialize a new or recovering host"
#MISE interactive=true
#MISE extends="uncached"
set -eu
[ "$#" = 0 ] || exit 2
[ -z "${MISE_SETUP_IN_PROGRESS:-}" ] || exit 0
case ${MISE_INSTALLED_TOOLS:-} in
*age* | *alloy* | *blackbox_exporter* | *caddy* | *cloudflared* | *fnox* | *loki* | *node_exporter* | *pitchfork* | *prometheus* | *restic* | *taplo*) ;;
*) exit 0 ;;
esac
ready=true
for path in /etc/fnox/config.toml /etc/fnox/operational.key /etc/fnox/restic-password.age /Library/LaunchDaemons/pitchfork.plist \
  /Users/svc_forgejo/forgejo-data/data/forgejo.db /Users/svc_observability/grafana-data/grafana.db; do
  if ! sudo test -f "$path"; then ready=false; fi
done
if [ "$ready" = true ]; then
  # Mise stays unprivileged. Only each fixed administrative operation elevates.
  mise run daemon:install
  mise run daemon:activate
else
  printf '%s\n' 'Tools installed; no services changed. Use setup.sh --new for an empty server, or follow README recovery.'
fi
