#!/bin/sh
#MISE description="Configure the built-in Postfix for local, direct outbound mail"
set -eu

while IFS='|' read -r name value; do
  sudo /usr/sbin/postconf -e "$name = $value"
done <<'POSTCONF'
myhostname|mail.maclong.dev
myorigin|$myhostname
inet_interfaces|loopback-only
inet_protocols|ipv4
mynetworks|127.0.0.0/8, [::1]/128
relayhost|
smtp_generic_maps|hash:/etc/postfix/generic
smtp_tls_security_level|may
smtp_tls_CAfile|/etc/ssl/cert.pem
smtpd_client_restrictions|permit_mynetworks, reject
smtpd_relay_restrictions|permit_mynetworks, reject
disable_vrfy_command|yes
POSTCONF

sudo install -o root -g wheel -m 644 \
  /Users/mac/Developer/configuration/services/mail/generic /etc/postfix/generic
sudo /usr/sbin/postmap /etc/postfix/generic
sudo /usr/sbin/postfix check

while IFS='|' read -r name expected; do
  actual=$(sudo /usr/sbin/postconf -h "$name")
  if [ "$actual" != "$expected" ]; then
    printf 'Postfix setting %s: expected <%s>, got <%s>\n' "$name" "$expected" "$actual" >&2
    exit 1
  fi
done <<'POSTCONF_TESTS'
myhostname|mail.maclong.dev
inet_interfaces|loopback-only
mynetworks|127.0.0.0/8, [::1]/128
relayhost|
POSTCONF_TESTS

sudo launchctl enable system/com.apple.postfix.master
sudo launchctl kickstart -k system/com.apple.postfix.master

printf '%s\n' 'Postfix is ready for local, direct delivery.'
