#!/bin/sh
#MISE description="Acknowledge a completed infrastructure update review for Grafana/ntfy"
set -eu
mise run updates:check
printf '%s\n' 'Confirm you reviewed mise.toml, services/maintenance/versions.toml and the README update checklist.'
printf '%s' 'Type reviewed to reset the 30-day reminder: '
read -r confirmation
[ "$confirmation" = reviewed ] || exit 1
exec sudo -u svc_observability /bin/sh /Users/mac/Developer/configuration/services/metrics/updates-reviewed.sh
