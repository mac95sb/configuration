#!/bin/sh
#MISE description="Atomically publish macOS SoC metrics for node_exporter"
#MISE extends="uncached"
set -eu
[ "$#" = 0 ] || exit 2
output=${METRICS_FILE:-/Users/svc_observability/textfile/soc.prom}
ioreg_bin=${IOREG_BIN:-/usr/sbin/ioreg}
memory_pressure_bin=${MEMORY_PRESSURE_BIN:-/usr/bin/memory_pressure}
gpu=$("$ioreg_bin" -r -c IOAccelerator -d 1 -l)
gpu_util=$(printf '%s\n' "$gpu" | sed -n 's/.*"Device Utilization %"=\([0-9][0-9]*\).*/\1/p' | awk 'NR==1')
gpu_memory=$(printf '%s\n' "$gpu" | sed -n 's/.*"In use system memory"=\([0-9][0-9]*\).*/\1/p' | awk 'NR==1')
ane_busy_ms=$("$ioreg_bin" -r -n ane0 -d 0 | sed -n 's/.*busy [0-9][0-9]* (\([0-9][0-9]*\) ms).*/\1/p' | awk 'NR==1')
battery=$("$ioreg_bin" -r -c AppleSmartBattery -d 0 -l)
power_mw=$(printf '%s\n' "$battery" | sed -n 's/.*"SystemLoad"=\([0-9][0-9]*\).*/\1/p' | awk 'NR==1')
battery_percent=$(printf '%s\n' "$battery" | sed -n 's/.*"CurrentCapacity" = \([0-9][0-9]*\).*/\1/p' | awk 'NR==1')
memory_free_percent=$("$memory_pressure_bin" -Q | sed -n 's/^System-wide memory free percentage: \([0-9][0-9]*\)%$/\1/p')
for value in "$gpu_util" "$gpu_memory" "$ane_busy_ms" "$power_mw" "$battery_percent" "$memory_free_percent"; do
  case $value in '' | *[!0-9]*)
    printf 'unexpected host metric: %s\n' "$value" >&2
    exit 1
    ;;
  esac
done
tmp=$(mktemp "$output.XXXXXX")
trap 'rm -f "$tmp"' EXIT
trap 'exit 1' HUP INT TERM
cat >"$tmp" <<EOF
# HELP host_gpu_utilization_ratio Current GPU device utilization.
# TYPE host_gpu_utilization_ratio gauge
host_gpu_utilization_ratio $(awk -v value="$gpu_util" 'BEGIN { print value / 100 }')
# HELP host_gpu_memory_bytes Unified memory currently attributed to the GPU.
# TYPE host_gpu_memory_bytes gauge
host_gpu_memory_bytes $gpu_memory
# HELP host_ane_busy_seconds_total Cumulative ANE driver busy time.
# TYPE host_ane_busy_seconds_total counter
host_ane_busy_seconds_total $(awk -v value="$ane_busy_ms" 'BEGIN { print value / 1000 }')
# HELP host_power_watts Current estimated system power consumption.
# TYPE host_power_watts gauge
host_power_watts $(awk -v value="$power_mw" 'BEGIN { print value / 1000 }')
# HELP host_battery_charge_ratio Current battery charge.
# TYPE host_battery_charge_ratio gauge
host_battery_charge_ratio $(awk -v value="$battery_percent" 'BEGIN { print value / 100 }')
# HELP host_memory_free_ratio macOS system-wide memory free fraction; not memory pressure.
# TYPE host_memory_free_ratio gauge
host_memory_free_ratio $(awk -v value="$memory_free_percent" 'BEGIN { print value / 100 }')
EOF
chmod 640 "$tmp"
mv "$tmp" "$output"
