{
  "agent": {
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "model": "gpt-6-luna",
      "provider": "openai-subscribed"
    },
    "favorite_models": [
      {
        "effort": "medium",
        "enable_thinking": true,
        "model": "gpt-6-luna",
        "provider": "openai-subscribed"
      },
      {
        "effort": "low",
        "enable_thinking": true,
        "model": "gpt-6.1-terra",
        "provider": "openai-subscribed"
      },
      {
        "effort": "medium",
        "enable_thinking": true,
        "model": "gpt-6.1-sol",
        "provider": "openai-subscribed"
      },
      {
        "effort": "medium",
        "enable_thinking": true,
        "model": "gpt-6-astra",
        "provider": "openai-subscribed"
      }
    ],
  },
  "auto_install_extensions": {
    "comment": true,
    "git-firefly": true,
    "html": true,
    "make": true,
    "markdown-oxide": true,
    "package-swift-lsp": true,
    "pbxproj": true,
    "sql": true,
    "swift": true,
    "toml": true,
    "vue": true,
    "xcode-themes": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_family": "Liga SFMono Nerd Font",
  "buffer_font_size": 11,
  "completion_menu_item_kind": "symbol",
  "context_servers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    }
  },
  "diff_view_style": "unified",
  "git_panel": {
    "default_width": 240,
    "tree_view": true
  },
  "preferred_line_length": 120,
  "relative_line_numbers": "enabled",
  "tab_bar": {
    "show_nav_history_buttons": true
  },
  "tab_size": 2,
  "tabs": {
    "close_position": "left",
    "file_icons": true,
    "git_status": true
  },
  "terminal": {
    "font_size": 12
  },
  "theme": {
    "dark": "Xcode Default Darker",
    "light": "Xcode Default Light",
    "mode": "system"
  },
  "title_bar": {
    "show_user_picture": false
  },
  "ui_font_family": "SF Pro Display",
  "ui_font_size": 12,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "never"
  },
  "vim_mode": true,
  "which_key": {
    "delay_ms": 300,
    "enabled": true
  }
}
