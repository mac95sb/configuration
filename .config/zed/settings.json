{
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry"
    }
  },
  "agent": {
    "default_model": {
      "enable_thinking": false,
      "model": "moonshotai/Kimi-K3-TEE",
      "provider": "Chutes"
    },
    "default_profile": "write",
    "favorite_models": [],
    "model_parameters": []
  },

  "auto_install_extensions": {
    "comment": true,
    "git-firefly": true,
    "html": true,
    "make": true,
    "markdown-oxide": true,
    "package-swift-lsp": true,
    "pbxproj": true,
    "pkl": true,
    "sql": true,
    "swift": true,
    "toml": true,
    "vue": true,
    "xcode-themes": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_family": "Liga SFMono Nerd Font",
  "buffer_font_size": 11,
  "completion_menu_item_kind": "symbol",
  "context_servers": {
    "linear": {
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "command": "npx",
      "enabled": true
    }
  },
  "diff_view_style": "unified",
  "git_panel": {
    "default_width": 240,
    "tree_view": true
  },
  "language_models": {
    "openai_compatible": {
      "Chutes": {
        "api_url": "https://llm.chutes.ai/v1",
        "available_models": [
          {
            "capabilities": {
              "chat_completions": true,
              "images": false,
              "interleaved_reasoning": true,
              "max_tokens_parameter": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "tools": true
            },
