  "preferred_line_length": 120,
  "relative_line_numbers": "enabled",
  "tab_bar": {
    "show_nav_history_buttons": true
  },
  "tab_size": 2,
  "tabs": {
    "close_position": "left",
    "file_icons": true,
    "git_status": true
  },
  "terminal": {
    "font_size": 12
  },
  "theme": {
    "dark": "Xcode Default Darker",
    "light": "Xcode Default Light",
    "mode": "system"
  },
  "ui_font_family": "SF Pro Display",
  "ui_font_size": 12,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "never"
  },
  "vim_mode": true,
  "which_key": {
    "delay_ms": 300,
    "enabled": true
  }
}
