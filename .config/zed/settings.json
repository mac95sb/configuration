{
  "language_models": {
    "openai_compatible": {
      "Chutes": {
        "api_url": "https://llm.chutes.ai/v1",
        "available_models": [
          {
            "name": "MiniMaxAI/MiniMax-M2.5-TEE",
            "display_name": "MiniMax 2.5",
            "max_tokens": 196608,
            "max_output_tokens": 65536,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "max_tokens_parameter": true,
            },
          },
          {
            "name": "moonshotai/Kimi-K2.6-TEE",
            "display_name": "Kimi K2.6",
            "max_tokens": 262144,
            "max_output_tokens": 65535,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "max_tokens_parameter": true,
            },
          },
          {
            "name": "zai-org/GLM-5.2-TEE",
            "display_name": "GLM 5.2",
            "max_tokens": 1048576,
            "max_output_tokens": 65535,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "max_tokens_parameter": true,
            },
          },
        ],
      },
    },
  },
  "terminal": {
    "font_size": 12.0,
  },
  "tab_size": 2,
  "agent": {
    "default_model": {
      "provider": "Chutes",
      "model": "moonshotai/Kimi-K2.6-TEE",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "default_profile": "write",
    "model_parameters": [],
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-terra"
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "model": "default",
        "mode": "bypassPermissions",
      },
      "type": "registry",
    },
  },

  "auto_install_extensions": {
    "comment": true,
    "git-firefly": true,
    "html": true,
    "make": true,
    "markdown-oxide": true,
    "package-swift-lsp": true,
    "pbxproj": true,
    "pkl": true,
    "sql": true,
    "swift": true,
    "toml": true,
    "vue": true,
    "xcode-themes": true,
  },

  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },

  "buffer_font_family": "Liga SFMono Nerd Font",
  "buffer_font_size": 12.0,
  "completion_menu_item_kind": "symbol",
  "diff_view_style": "unified",
  "format_on_save": "on",

  "git_panel": {
    "default_width": 240,
    "tree_view": true,
  },

  "preferred_line_length": 120,
  "relative_line_numbers": "enabled",

  "tab_bar": {
    "show_nav_history_buttons": true,
  },

  "tabs": {
    "close_position": "left",
    "file_icons": true,
    "git_status": true,
  },

  "theme": {
    "dark": "Xcode Default Darker",
    "light": "Xcode Default Light",
    "mode": "dark",
  },

  "ui_font_family": "SF Pro Display",
  "ui_font_size": 13.0,

  "vim": {
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "never",
  },

  "vim_mode": true,

  "which_key": {
    "delay_ms": 300,
    "enabled": true,
  },
}
