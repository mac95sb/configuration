[branch]
	sort = -committerdate

[commit]
	gpgsign = true

[core]
	pager = less -FRX

[fetch]
	prune = true

[gpg]
	format = ssh

[init]
	defaultBranch = main

[merge]
	conflictstyle = zdiff3

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[rerere]
	enabled = true

[tag]
	gpgsign = true

[user]
	email = contact@maclong.dev
	name = Mac
	signingkey = ~/.ssh/id_ed25519

[url "ssh://git@127.0.0.1:2222/"]
	insteadOf = git@git.maclong.dev:
[hook "hk-pre-commit"]
	command = test \"${HK:-1}\" = \"0\" || ~/.local/bin/mise x hk -- hk run pre-commit --from-hook --staged
	event = pre-commit
[hook "hk-pre-push"]
	command = test \"${HK:-1}\" = \"0\" || ~/.local/bin/mise x hk -- hk run pre-push --from-hook
	event = pre-push
