amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"

exclude = List(".config/zsh/.p10k.zsh")

local linters = new Mapping<String, Step> {
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = (Builtins.shfmt) {
    check = "shfmt -i 2 -d --apply-ignore {{files}}"
    fix = "shfmt -i 2 -w --apply-ignore {{files}}"
  }
  ["taplo"] = Builtins.taplo
  ["taplo-format"] = Builtins.taplo_format
  ["mise"] = Builtins.mise
  ["pkl-format"] = Builtins.pkl_format
  ["detect-private-key"] = Builtins.detect_private_key
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["caddy-validate"] {
    glob = List("services/caddy/Caddyfile")
    check =
      "validation_log=$(mktemp \"${TMPDIR:-/tmp}/caddy-validate.XXXXXX\") && trap 'rm -f \"$validation_log\"' EXIT && CADDY_ACCESS_LOG=\"$validation_log\" caddy validate --config services/caddy/Caddyfile"
  }
  ["cloudflared-validate"] {
    glob = List("services/cloudflared/config.yml")
    check = "cloudflared --config services/cloudflared/config.yml tunnel ingress validate"
  }
  ["blackbox-validate"] {
    glob = List("services/blackbox/config.yml")
    check = "blackbox_exporter --config.file=services/blackbox/config.yml --config.check"
  }
  ["prometheus-validate"] {
    glob = List("services/prometheus/config.yml")
    check = "promtool check config services/prometheus/config.yml"
  }
  ["loki-validate"] {
    glob = List("services/loki/config.yml")
    check = "loki -config.file=services/loki/config.yml -verify-config"
  }
  ["alloy-validate"] {
    glob = List("services/alloy/config.alloy")
    check = "alloy validate services/alloy/config.alloy"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["pre-push"] {
    steps = linters
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}
