{
	default_bind 127.0.0.1

	# Per-server HTTP metrics are off by default; the admin endpoint only
	# exposes admin and upstream-health metrics without this.
	servers {
		metrics
	}
}

:8080 {
	log {
		output file {$CADDY_ACCESS_LOG:/var/log/caddy/access.log} {
			mode 0640
			# Defaults are 100MiB x 10 kept for 90 days. Client IPs land here
			# in plaintext and are only scrubbed on the way to Loki, so roll
			# fast rather than merely bounded.
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 48h
		}
	}

	@dashboard host dashboard.maclong.dev
	handle @dashboard {
		reverse_proxy 127.0.0.1:3000
	}

	@git host git.maclong.dev
	handle @git {
		reverse_proxy 127.0.0.1:3030
	}

	@status host status.maclong.dev
	handle @status {
		respond "ok"
	}

	handle {
		respond 404
	}
}
