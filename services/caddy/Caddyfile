{
	default_bind 127.0.0.1

	servers {
		metrics
		# Only cloudflared's local connection may supply the client address.
		trusted_proxies static 127.0.0.1/32
		client_ip_headers Cf-Connecting-Ip
	}
}

:8080 {
	log {
		format filter {
			wrap json
			fields {
				request>headers>Cf-Access-Jwt-Assertion delete
				request>headers>Cf-Access-Authenticated-User-Email delete
			}
		}
		output file {$CADDY_ACCESS_LOG:/var/log/caddy/access.log} {
			mode 0640
			# Raw client IPs exist here before Alloy scrubs them, so retain briefly.
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 48h
		}
	}

	@dashboard host dashboard.maclong.dev
	@git host git.maclong.dev
	@status host status.maclong.dev

	route {
		reverse_proxy @dashboard 127.0.0.1:3000
		reverse_proxy @git 127.0.0.1:3030
		respond @status "ok"
		respond 404
	}
}
