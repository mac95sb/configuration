{
	default_bind 127.0.0.1

	servers {
		metrics
	}
}

:8080 {
	log {
		output file {$CADDY_ACCESS_LOG:/var/log/caddy/access.log} {
			mode 0640
			# Raw client IPs exist here before Alloy scrubs them, so retain briefly.
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 48h
		}
	}

	@dashboard host dashboard.maclong.dev
	@git host git.maclong.dev
	@status host status.maclong.dev

	route {
		reverse_proxy @dashboard 127.0.0.1:3000
		reverse_proxy @git 127.0.0.1:3030
		respond @status "ok"
		respond 404
	}
}
