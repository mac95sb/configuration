// file_match polls, so a file created after Alloy starts is still picked up.
local.file_match "caddy" {
	path_targets = [{__path__ = "/var/log/caddy/access.log"}]
	sync_period  = "10s"
}

loki.source.file "caddy" {
	targets    = local.file_match.caddy.targets
	forward_to = [loki.process.caddy.receiver]
}

loki.process "caddy" {
	forward_to = [loki.write.local.receiver]

	// Rewrites the stored log line itself, not just an extracted copy —
	// the plaintext IP never reaches Loki. It does reach the Caddy access
	// log first, which is why that file rolls fast. Same input produces
	// the same token (trace correlation intact) without the salt.
	// `.Value` is the matched capture group's own text, not a named
	// field — a named group only matters for exposing it elsewhere.
	// Every capturing group is rewritten, so the field-name alternation
	// must stay non-capturing or the key gets hashed along with the IP.
	stage.replace {
		expression = "\"(?:remote_ip|client_ip)\":\"(?P<v>[^\"]+)\""
		replace    = "{{ Hash .Value \"" + sys.env("SCRUB_SALT") + "\" }}"
	}

	// Caddy's default access log dumps every request header verbatim,
	// including these two — Cloudflare's own forwarded-client-IP
	// headers survive even though the connection-level IP is scrubbed.
	stage.replace {
		expression = "\"(?:Cf-Connecting-Ip|X-Forwarded-For)\":\\[\"(?P<v>[^\"]+)\"\\]"
		replace    = "{{ Hash .Value \"" + sys.env("SCRUB_SALT") + "\" }}"
	}
}

local.file_match "daemons" {
	path_targets = [{__path__ = "/var/log/services/pitchfork.log"}]
	sync_period  = "10s"
}

loki.source.file "daemons" {
	targets    = local.file_match.daemons.targets
	forward_to = [loki.process.daemons.receiver]
}

loki.process "daemons" {
	forward_to = [loki.write.local.receiver]

	// Tag only: the timestamp prefix is governed by logs.timestamp_format.
	stage.regex {
		expression = "\\[global/(?P<service>[^\\]]+)\\]"
	}

	stage.labels {
		values = {service = ""}
	}
}

loki.write "local" {
	endpoint {
		url = "http://127.0.0.1:3100/loki/api/v1/push"
	}
}
