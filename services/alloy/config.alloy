// file_match polls, so a file created after Alloy starts is still picked up.
local.file_match "caddy" {
	path_targets = [{__path__ = "/var/log/caddy/access.log"}]
	sync_period  = "10s"
}

loki.source.file "caddy" {
	targets    = local.file_match.caddy.targets
	forward_to = [loki.process.caddy.receiver]
}

loki.process "caddy" {
	forward_to = [loki.process.level.receiver]

	// Rewrites the stored log line itself, not just an extracted copy —
	// the plaintext IP never reaches Loki. It does reach the Caddy access
	// log first, which is why that file rolls fast. Same input produces
	// the same token (trace correlation intact) without the salt.
	// `.Value` is the matched capture group's own text, not a named
	// field — a named group only matters for exposing it elsewhere.
	// Every capturing group is rewritten, so the field-name alternation
	// must stay non-capturing or the key gets hashed along with the IP.
	stage.replace {
		expression = "\"(?:remote_ip|client_ip)\":\"(?P<v>[^\"]+)\""
		replace    = "{{ Hash .Value \"" + sys.env("SCRUB_SALT") + "\" }}"
	}

	// Caddy's default access log dumps every request header verbatim,
	// including these two — Cloudflare's own forwarded-client-IP
	// headers survive even though the connection-level IP is scrubbed.
	stage.replace {
		expression = "\"(?:Cf-Connecting-Ip|X-Forwarded-For)\":\\[\"(?P<v>[^\"]+)\"\\]"
		replace    = "{{ Hash .Value \"" + sys.env("SCRUB_SALT") + "\" }}"
	}
}

local.file_match "daemons" {
	path_targets = [{__path__ = "/var/log/services/pitchfork.log"}]
	sync_period  = "10s"
}

loki.source.file "daemons" {
	targets    = local.file_match.daemons.targets
	forward_to = [loki.process.daemons.receiver]
}

loki.process "daemons" {
	forward_to = [loki.process.level.receiver]

	// Tag only: the timestamp prefix is governed by logs.timestamp_format.
	stage.regex {
		expression = "\\[global/(?P<service>[^\\]]+)\\]"
	}

	stage.labels {
		values = {service = ""}
	}
}

local.file_match "postfix" {
	path_targets = [{__path__ = "/var/log/services/postfix.log", service = "postfix"}]
	sync_period  = "10s"
}

loki.source.file "postfix" {
	targets    = local.file_match.postfix.targets
	forward_to = [loki.process.postfix.receiver]
}

loki.process "postfix" {
	forward_to = [loki.process.level.receiver]

	stage.regex {
		expression = "localhost (?P<postfix_component>postfix|master|pickup|cleanup|qmgr|smtp|bounce|defer|local)\\["
	}

	stage.regex {
		expression = "status=(?P<delivery_status>sent|deferred|bounced)"
	}

	stage.labels {
		values = {
			delivery_status   = "",
			postfix_component = "",
		}
	}

	stage.metrics {
		metric.counter {
			name              = "delivery_sent_total"
			description       = "Messages accepted by a recipient mail server."
			prefix            = "postfix_"
			source            = "delivery_status"
			value             = "sent"
			action            = "inc"
			max_idle_duration = "168h"
		}

		metric.counter {
			name              = "delivery_deferred_total"
			description       = "Messages awaiting another delivery attempt."
			prefix            = "postfix_"
			source            = "delivery_status"
			value             = "deferred"
			action            = "inc"
			max_idle_duration = "168h"
		}

		metric.counter {
			name              = "delivery_bounced_total"
			description       = "Messages permanently rejected by a recipient mail server."
			prefix            = "postfix_"
			source            = "delivery_status"
			value             = "bounced"
			action            = "inc"
			max_idle_duration = "168h"
		}
	}
}

loki.process "level" {
	forward_to = [loki.write.local.receiver]

	// A line without an explicit severity is routine output. Normalise the
	// formats emitted by the managed services into one low-cardinality label.
	stage.static_labels {
		values = {level = "INFO"}
	}

	stage.match {
		selector = "{level=\"INFO\"} |~ \"(?i)(\\\"level\\\"\\\\s*:\\s*\\\"(?:warn(?:ing)?|wrn)\\\"|\\\\blevel=(?:warn(?:ing)?|wrn)\\\\b|\\\\[(?:W|WRN|WARN|WARNING)\\\\]|\\\\] \\S+ (?:WRN|WARN|WARNING) |\\\\]: warn(?:ing)?:|status=deferred\\\\b)\""

		stage.static_labels {
			values = {level = "WARN"}
		}
	}

	stage.match {
		selector = "{level=~\"INFO|WARN\"} |~ \"(?i)(\\\"level\\\"\\\\s*:\\s*\\\"(?:error|err|fatal|critical|crit|panic)\\\"|\\\\blevel=(?:error|err|fatal|critical|crit|panic)\\\\b|\\\\[(?:E|F|ERR|ERROR|FATAL)\\\\]|\\\\] \\S+ (?:ERR|ERROR|FATAL) |\\\\]: (?:error|fatal|panic):|status=bounced\\\\b)\""

		stage.static_labels {
			values = {level = "ERROR"}
		}
	}
}

loki.write "local" {
	endpoint {
		url = "http://127.0.0.1:3100/loki/api/v1/push"
	}
}
