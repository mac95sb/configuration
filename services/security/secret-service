#!/bin/sh
# The second stage is a separate protected file: never accept a caller-selected command.
set -eu
[ "$(/usr/bin/id -u)" = 0 ] || {
  echo 'Root is required.' >&2
  exit 1
}
cd /var/empty
exec /usr/bin/env -i PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin \
  HOME=/var/root USER=root LOGNAME=root \
  /usr/local/bin/python3 -I /usr/local/libexec/mac-server/secret_launcher.py "$@"
