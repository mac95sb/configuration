{
  "uid": "infra-health",
  "title": "Infrastructure health",
  "tags": [
    "infrastructure"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Scrape target up",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0,
          "mappings": [],
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up",
          "legendFormat": "{{job}} {{instance}}",
          "refId": "A"
        }
      ],
      "description": "1 = Prometheus reached that target, 0 = it did not. The same signal as the Daemon scrape health tiles on Server overview, but over time, so you can see when something dropped and for how long."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Public endpoint probe",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0,
          "mappings": [],
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_success",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "description": "1 = the hostname answered a probe through Cloudflare, 0 = it did not. Gaps show outages as your users would have experienced them, not as the host saw them."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Probe duration",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0,
          "mappings": [],
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_duration_seconds",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "description": "How long each public probe took, end to end through Cloudflare. Watch for a step change rather than an absolute value \u2014 a sustained rise usually means a slow backend, not a slow network."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Log entries shipped to Loki",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0,
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(loki_write_sent_entries_total[5m]))",
          "legendFormat": "sent/s",
          "refId": "A"
        }
      ],
      "description": "Rate of log lines successfully accepted by Loki. Should track activity. Flat zero while services are clearly running means the shipping path has broken."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Log entries dropped (should stay flat at zero)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0,
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(loki_write_dropped_entries_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "description": "Log lines Loki refused. Any value above zero means lines are being lost \u2014 usually rate limiting or a malformed stream \u2014 and the logs you are reading are then incomplete."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Disk used",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0,
          "mappings": [],
          "unit": "percent",
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
          "legendFormat": "free",
          "refId": "A"
        }
      ],
      "description": "Share of the root volume in use, over time. The Server overview tile shows the same figure right now."
    }
  ],
  "description": "Trends over time for the whole system: scrape and probe history, log pipeline throughput, and disk headroom. Use this when you want to know when something broke and for how long. For a right-now view of individual services, use Server overview instead."
}
