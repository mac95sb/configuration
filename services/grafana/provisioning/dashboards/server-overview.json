{
  "uid": "server-overview",
  "title": "Server overview",
  "tags": [
    "server"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Daemon uptime (24h)",
      "description": "Share of scrapes that reached each daemon over the last day. Multiplied by current state, so a target that is down right now reads DOWN in red instead of a reassuring average. While it is up, the number is its uptime over the window. Restarts count against it — a probe failing while cloudflared reconnects is a real failure from outside. Time when Prometheus itself was down is absent rather than zero, so this reads higher than truth after a Prometheus restart.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "datasourceUid": "prometheus",
          "expr": "avg_over_time(up[24h]) * 100 * up",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "min": 90,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99
              },
              {
                "color": "#4fb8ac",
                "value": 99.9
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Endpoint uptime (24h)",
      "description": "Share of probes through Cloudflare that succeeded over the last day. Multiplied by current state, so a target that is down right now reads DOWN in red instead of a reassuring average. While it is up, the number is its uptime over the window. Restarts count against it — a probe failing while cloudflared reconnects is a real failure from outside.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "datasourceUid": "prometheus",
          "expr": "avg_over_time(probe_success[24h]) * 100 * probe_success",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "min": 90,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99
              },
              {
                "color": "#4fb8ac",
                "value": 99.9
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "orientation": "auto"
      }
    },
    {
      "type": "row",
      "title": "Host",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Host compute and memory",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU",
          "instant": false
        },
        {
          "refId": "B",
          "datasourceUid": "prometheus",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(node_memory_active_bytes + node_memory_wired_bytes + node_memory_compressed_bytes) / node_memory_total_bytes * 100",
          "legendFormat": "memory",
          "instant": false
        },
        {
          "refId": "C",
          "datasourceUid": "prometheus",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "host_gpu_utilization_ratio * 100",
          "legendFormat": "GPU",
          "instant": false
        },
        {
          "refId": "D",
          "datasourceUid": "prometheus",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_max(rate(host_ane_busy_seconds_total[1m]) * 100, 100)",
          "legendFormat": "Neural Engine",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4fb8ac"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "memory"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#94a19b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GPU"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f2cc60"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Neural Engine"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#b877d9"
                }
              }
            ]
          }
        ]
      },
      "description": "CPU, GPU, Neural Engine and memory use over the selected period. GPU is the current device utilization reported by I/O Registry; Neural Engine is derived from its cumulative driver-busy time."
    },
    {
      "type": "timeseries",
      "title": "Load (1m)",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_load1",
          "legendFormat": "load1",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4fb8ac",
                "value": null
              },
              {
                "color": "orange",
                "value": 8
              },
              {
                "color": "red",
                "value": 12
              }
            ]
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#4fb8ac"
          }
        },
        "overrides": []
      },
      "description": "Average number of processes wanting CPU over the last minute, including ones waiting their turn. Read against 12 cores: under 12 has headroom, above 12 means queueing. Amber 8, red 12."
    },
    {
      "type": "timeseries",
      "title": "Disk used",
      "gridPos": {
        "x": 18,
        "y": 7,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
          "legendFormat": "used",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4fb8ac",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#4fb8ac"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "description": "Share of the root filesystem in use, including its trend over the selected period. Amber 80%, red 90%."
    },
    {
      "type": "row",
      "title": "Spike attribution",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU by daemon",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "datasourceUid": "prometheus",
          "expr": "sum by (job) (rate(process_cpu_seconds_total[5m])) * 100 / scalar(count(count by (cpu) (node_cpu_seconds_total)))",
          "legendFormat": "{{job}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "description": "Share of total host CPU used by each scraped daemon. Match a host spike to a line here; a host spike with no matching daemon points to another macOS process or system work.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Memory by daemon",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "datasourceUid": "prometheus",
          "expr": "sum by (job) (process_resident_memory_bytes) / scalar(node_memory_total_bytes) * 100",
          "legendFormat": "{{job}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "description": "Share of host memory held resident by each scraped daemon. This covers managed services, not desktop applications, backup subprocesses or the kernel.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "row",
      "title": "Public endpoints",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Probe duration",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0,
          "mappings": [],
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_duration_seconds",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "description": "How long each public probe took, end to end through Cloudflare. Watch for a step change rather than an absolute value — a sustained rise usually means a slow backend, not a slow network."
    },
    {
      "type": "stat",
      "title": "TLS certificate expires in",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1209600
              },
              {
                "color": "#4fb8ac",
                "value": 2592000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_ssl_earliest_cert_expiry - time()",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "orientation": "auto"
      },
      "description": "Time remaining on the earliest certificate in each endpoint's TLS chain. Amber below 30 days, red below 14 days; the alert fires at 30 days."
    },
    {
      "type": "stat",
      "title": "Public endpoint HTTP status",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "probe_http_status_code",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "orientation": "auto"
      },
      "description": "Raw status code returned by each public endpoint. Expected responses are 200 for status and Forgejo, and a 302 Cloudflare Access redirect for Grafana."
    },
    {
      "type": "timeseries",
      "title": "Cloudflare tunnel connections",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "cloudflared_tunnel_ha_connections",
          "legendFormat": "active",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "description": "Active connections from cloudflared to Cloudflare's edge. Four is normal — the tunnel keeps redundant connections to separate data centres. Dropping toward zero means the tunnel is failing and the public hostnames go with it."
    },
    {
      "type": "row",
      "title": "Services",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Caddy requests by status",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (rate(caddy_http_response_duration_seconds_count[5m]))",
          "legendFormat": "{{code}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "description": "Completed HTTP responses per second, split by status code. At this traffic level the absolute rate is meaningless (0.03/s is one request every 30s, mostly health probes). Watch the shape, not the number: any 5xx series appearing at all is the signal."
    },
    {
      "type": "timeseries",
      "title": "Caddy upstream health",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "datasourceUid": "prometheus",
          "expr": "caddy_reverse_proxy_upstreams_healthy",
          "legendFormat": "{{upstream}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "description": "Whether Caddy can reach each backend it proxies to. 1 = reachable, 0 = not. :3000 is Grafana, :3030 is Forgejo. Drops here precede a failed public probe."
    },
    {
      "type": "timeseries",
      "title": "Grafana active alerts",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "grafana_alerting_active_alerts",
          "legendFormat": "alerts",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "description": "How many alert rules are currently firing. Flat at zero is healthy. This counts Grafana's own view, so it stays accurate even if the ntfy push fails to deliver."
    },
    {
      "type": "timeseries",
      "title": "Log entries dropped",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "min": 0,
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(loki_write_dropped_entries_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "description": "Log lines Loki refused. Any value above zero means lines are being lost — usually rate limiting or a malformed stream — and the logs you are reading are then incomplete."
    },
    {
      "type": "row",
      "title": "Backups",
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Since last backup",
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - backup_last_success_seconds",
          "legendFormat": "backup",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4fb8ac",
                "value": null
              },
              {
                "color": "orange",
                "value": 90000
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "orientation": "auto",
